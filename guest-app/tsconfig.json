{
  /**
   * shop/tsconfig.json
   * ------------------
   * TypeScript configuration for the React + Vite SPA.
   *
   * Connection map:
   *   <- vite.config.ts   : Vite reads this automatically via @vitejs/plugin-react
   *   -> src/**\/*.tsx    : all React component files
   *   -> src/**\/*.ts     : hooks, api client, context, types
   *   -> src/types/       : shared interfaces mirroring Django Ninja schemas
   *
   * Key decisions:
   *   "target": "ES2020"       — supported by all modern browsers + Node 20
   *   "module": "ESNext"       — Vite handles bundling, so ESModules throughout
   *   "moduleResolution": "bundler" — correct for Vite (not "node")
   *   "strict": true           — catches null/undefined bugs at compile time
   *   "paths"                  — "@/" alias maps to "src/" so imports stay clean:
   *                              import { Product } from "@/types/product"
   *                              instead of "../../types/product"
   *   "noEmit": true           — Vite does the actual transpile; tsc is type-check only
   *   "jsx": "react-jsx"       — React 18 automatic JSX transform (no import React needed)
   */
  "compilerOptions": {
    /* ── Language target ──────────────────────────────────────────────── */
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,

    /* ── Module system ────────────────────────────────────────────────── */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* ── JSX ──────────────────────────────────────────────────────────── */
    "jsx": "react-jsx",

    /* ── Strict type checking ─────────────────────────────────────────── */
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* ── Path aliases ─────────────────────────────────────────────────── */
    /* "@/" maps to "src/" — used across all imports in the shop SPA.
       Example: import { fetchProducts } from "@/api/products"
       Example: import type { Product }  from "@/types/product"
       Example: import ProductCard       from "@/components/ProductCard" */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* ── Interop ──────────────────────────────────────────────────────── */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* ── Source maps (for browser devtools) ──────────────────────────── */
    "sourceMap": true,
    "declaration": false
  },

  /* Files TypeScript should type-check */
  "include": ["src"],

  /* Files to ignore (Vite config is a separate tsconfig) */
  "exclude": ["node_modules", "dist"]
}